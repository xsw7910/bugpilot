# What the source distribution carries, beyond the package itself.
#
# `tests/` is pruned: it is this repository's test suite, not something an
# installer needs. Its work item ids are synthetic (the convention is in
# `tests/test_publishable.py`), and `docs/` is repository history, not package
# documentation — so neither belongs in the sdist.
#
# Checked, not assumed: `python -m build` put 19 test files in the sdist before
# this file existed.
prune tests
prune docs
prune extension
prune scripts
prune installer
