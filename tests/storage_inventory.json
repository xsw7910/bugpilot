   "pattern": "\\b(?:[Rr]ead|[Ww]rite|[Uu]pdate|[Ii]nspect)\\b[^\\n]{0,25}?\\.ai/",
   "watches": [
    "F23"
   ],
   "what": "a sentence telling the agent to read, write, update or inspect a `.ai/` path (heuristic)"
  },
  "path-helper": {
   "pattern": "(?:\\b(?:issue_dir|writable_issue_dir|memory_dir|writable_memory_file|user_config_dir|user_config_path|user_instructions_path|project_instructions_path|instructions_path|verification_path|ai_behavior_path|settings_path|profile_path|run_path|issue_path|retrieval_path|writable_dir|owned_path)|#itemFile)\\s*\\(",
